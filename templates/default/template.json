{
  "$schema": "../../shared/schema/template.schema.json",
  "slipr": "0.3",
  "id": "default",
  "name": "Slipr Default",
  "version": "1.6.0",
  "description": "Clean, neutral template used for samples and tests. Uses system fonts, so it needs no font files.",
  "theme": "theme.css",
  "reader": "reader.css",
  "styleguide": {
    "colors": {
      "primary": "#1F3A5F",
      "accent": "#F2A900",
      "text": "#1E2329",
      "muted": "#5B6573",
      "background": "#FFFFFF",
      "surface": "#F4F6F9"
    },
    "fonts": {
      "heading": "system-ui (Segoe UI, Roboto, Helvetica Neue)",
      "body": "system-ui (Segoe UI, Roboto, Helvetica Neue)",
      "code": "ui-monospace (Cascadia Code, Consolas, Menlo)"
    }
  },
  "pictureStyles": [
    { "id": "shadow", "label": "Shadow", "description": "A soft drop shadow", "pptxEffect": "shadow" },
    { "id": "soft", "label": "Soft edges", "description": "The edges fade into the background", "pptxEffect": "softEdges" },
    { "id": "rounded", "label": "Rounded corners", "pptxEffect": "roundedCorners" },
    { "id": "frame", "label": "Frame", "description": "A white border with a small shadow, like a print", "pptxEffect": "border" }
  ],
  "layouts": [
    {
      "id": "title",
      "name": "Title slide",
      "description": "Opening slide with title, subtitle and byline.",
      "file": "layouts/title.html",
      "slots": [
        { "name": "title", "type": "text", "label": "Title", "required": true, "maxLength": 80 },
        { "name": "subtitle", "type": "text", "label": "Subtitle", "maxLength": 140 },
        { "name": "byline", "type": "text", "label": "Byline", "help": "Speaker, event or date." }
      ]
    },
    {
      "id": "section",
      "name": "Section header",
      "description": "Divider that opens a chapter.",
      "file": "layouts/section.html",
      "slots": [
        { "name": "kicker", "type": "text", "label": "Kicker", "help": "Small text above the title, e.g. 'Chapter 2'.", "maxLength": 40 },
        { "name": "title", "type": "text", "label": "Title", "required": true, "maxLength": 60 },
        { "name": "subtitle", "type": "text", "label": "Subtitle", "maxLength": 120 }
      ]
    },
    {
      "id": "bullets",
      "name": "Title and bullets",
      "description": "The workhorse: a title and a bullet list.",
      "file": "layouts/bullets.html",
      "slots": [
        { "name": "title", "type": "text", "label": "Title", "required": true, "maxLength": 70 },
        { "name": "body", "type": "list", "label": "Bullets", "maxItems": 7 }
      ]
    },
    {
      "id": "two-column",
      "name": "Two columns",
      "description": "Comparison or side-by-side content.",
      "file": "layouts/two-column.html",
      "slots": [
        { "name": "title", "type": "text", "label": "Title", "required": true, "maxLength": 70 },
        { "name": "leftTitle", "type": "text", "label": "Left heading", "maxLength": 40 },
        { "name": "left", "type": "richtext", "label": "Left column", "required": true },
        { "name": "rightTitle", "type": "text", "label": "Right heading", "maxLength": 40 },
        { "name": "right", "type": "richtext", "label": "Right column", "required": true }
      ]
    },
    {
      "id": "image-full",
      "name": "Full image",
      "description": "One large image with optional title and caption.",
      "file": "layouts/image-full.html",
      "slots": [
        { "name": "image", "type": "image", "label": "Image", "required": true },
        { "name": "title", "type": "text", "label": "Title", "maxLength": 70 },
        { "name": "caption", "type": "text", "label": "Caption", "maxLength": 120 }
      ]
    },
    {
      "id": "diagram",
      "name": "Diagram",
      "description": "One large Mermaid diagram with optional title and caption.",
      "file": "layouts/diagram.html",
      "slots": [
        { "name": "diagram", "type": "diagram", "label": "Diagram", "required": true },
        { "name": "title", "type": "text", "label": "Title", "maxLength": 70 },
        { "name": "caption", "type": "text", "label": "Caption", "maxLength": 120 }
      ]
    },
    {
      "id": "web",
      "name": "Web page",
      "description": "A live web page (or its screenshot) with optional title and caption.",
      "file": "layouts/web.html",
      "slots": [
        { "name": "page", "type": "web", "label": "Web page", "required": true },
        { "name": "title", "type": "text", "label": "Title", "maxLength": 70 },
        { "name": "caption", "type": "text", "label": "Caption", "maxLength": 120 }
      ]
    },
    {
      "id": "pdf",
      "name": "PDF",
      "description": "A page (or a range of pages, one per click) of a PDF document, with optional title and caption.",
      "file": "layouts/pdf.html",
      "slots": [
        { "name": "document", "type": "pdf", "label": "PDF document", "required": true },
        { "name": "title", "type": "text", "label": "Title", "maxLength": 70 },
        { "name": "caption", "type": "text", "label": "Caption", "maxLength": 120 }
      ]
    },
    {
      "id": "graph",
      "name": "Graph",
      "description": "A network of nodes and links (built up step by step in audience mode), with optional title and caption.",
      "file": "layouts/graph.html",
      "slots": [
        { "name": "graph", "type": "graph", "label": "Graph", "required": true },
        { "name": "title", "type": "text", "label": "Title", "maxLength": 70 },
        { "name": "caption", "type": "text", "label": "Caption", "maxLength": 120 }
      ]
    },
    {
      "id": "map",
      "name": "Map",
      "description": "An interactive map with places (a tour from place to place in audience mode), with optional title and caption.",
      "file": "layouts/map.html",
      "slots": [
        { "name": "map", "type": "map", "label": "Map", "required": true },
        { "name": "title", "type": "text", "label": "Title", "maxLength": 70 },
        { "name": "caption", "type": "text", "label": "Caption", "maxLength": 120 }
      ]
    },
    {
      "id": "table",
      "name": "Table",
      "description": "A data table from a CSV file or typed in (sortable, filterable, totals; rows revealed step by step in audience mode), with optional title and caption.",
      "file": "layouts/table.html",
      "slots": [
        { "name": "table", "type": "table", "label": "Table", "required": true },
        { "name": "title", "type": "text", "label": "Title", "maxLength": 70 },
        { "name": "caption", "type": "text", "label": "Caption", "maxLength": 120 }
      ]
    }
  ],
  "pptxMapping": {
    "Title Slide": "title",
    "Section Header": "section",
    "Title and Content": "bullets",
    "Title Only": "bullets",
    "Two Content": "two-column",
    "Comparison": "two-column",
    "Picture with Caption": "image-full"
  }
}
