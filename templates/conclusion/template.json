{
  "$schema": "../../shared/schema/template.schema.json",
  "slipr": "0.3",
  "id": "conclusion",
  "name": "Conclusion (magenta)",
  "version": "0.1.1",
  "description": "Conclusion house style, derived from the official Conclusion PowerPoint template (Conclusion 2025, magenta). Internal use; see docs/specs/I-043-conclusion-template.md.",
  "theme": "theme.css",
  "reader": "reader.css",
  "styleguide": {
    "colors": {
      "black": "#000000",
      "white": "#FFFFFF",
      "magenta": "#BC448C",
      "magenta-10": "#F8ECF3",
      "red": "#E63232",
      "cyan": "#00AACB",
      "blue": "#1369AF",
      "yellow": "#F1CA13",
      "green": "#529F45",
      "purple": "#5A3F8C",
      "light-grey": "#F2F2F2"
    },
    "fonts": {
      "heading": "Arial Black (uppercase)",
      "body": "Arial",
      "quote": "Source Serif 4 (italic, optical size 48)"
    }
  },
  "pictureStyles": [
    { "id": "shadow", "label": "Shadow", "description": "A soft, neutral drop shadow", "pptxEffect": "shadow" },
    { "id": "soft", "label": "Soft edges", "description": "The edges fade into the background", "pptxEffect": "softEdges" },
    { "id": "rounded", "label": "Rounded corners", "pptxEffect": "roundedCorners" },
    { "id": "frame", "label": "Frame", "description": "A white border with a thin magenta line, like a print", "pptxEffect": "border" }
  ],
  "layouts": [
    {
      "id": "title-wave",
      "name": "Title slide (wave)",
      "description": "Opener without a photo: magenta wave on black.",
      "file": "layouts/title-wave.html",
      "slots": [
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "required": true,
          "maxLength": 52,
          "help": "Up to two lines of about 26 characters."
        },
        {
          "name": "byline",
          "type": "text",
          "label": "Speaker",
          "maxLength": 40
        }
      ]
    },
    {
      "id": "title-image",
      "name": "Title slide (image)",
      "description": "Opener with a full-bleed photo.",
      "file": "layouts/title-image.html",
      "slots": [
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "required": true,
          "maxLength": 52,
          "help": "Up to two lines of about 26 characters."
        },
        {
          "name": "byline",
          "type": "text",
          "label": "Speaker",
          "maxLength": 40
        },
        {
          "name": "image",
          "type": "image",
          "label": "Photo (16:9)",
          "required": true,
          "help": "Real photography from the brand library."
        }
      ]
    },
    {
      "id": "agenda",
      "name": "Agenda",
      "description": "Numbered agenda (up to 8 items) with a photo on the right. Also used for generated agenda slides.",
      "file": "layouts/agenda.html",
      "slots": [
        {
          "name": "kicker",
          "type": "text",
          "label": "Subtitle",
          "maxLength": 60
        },
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "required": true,
          "maxLength": 46
        },
        {
          "name": "items",
          "type": "list",
          "label": "Agenda items",
          "required": true,
          "maxItems": 8
        },
        {
          "name": "intro",
          "type": "text",
          "label": "Line on the photo",
          "maxLength": 90
        },
        {
          "name": "image",
          "type": "image",
          "label": "Photo (about 1:1)"
        }
      ]
    },
    {
      "id": "text",
      "name": "Text (white)",
      "description": "Standard text slide on white.",
      "file": "layouts/text.html",
      "slots": [
        {
          "name": "kicker",
          "type": "text",
          "label": "Subtitle",
          "maxLength": 60
        },
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "required": true,
          "maxLength": 46
        },
        {
          "name": "body",
          "type": "richtext",
          "label": "Text",
          "help": "Bullets (up to 4 levels), paragraphs, a bold line as subheading, A. and 1. lists. At most 12 bullets."
        }
      ]
    },
    {
      "id": "text-dark",
      "name": "Text (black)",
      "description": "Standard text slide on black.",
      "file": "layouts/text-dark.html",
      "slots": [
        {
          "name": "kicker",
          "type": "text",
          "label": "Subtitle",
          "maxLength": 60
        },
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "required": true,
          "maxLength": 46
        },
        {
          "name": "body",
          "type": "richtext",
          "label": "Text",
          "help": "Bullets (up to 4 levels), paragraphs, a bold line as subheading, A. and 1. lists. At most 12 bullets."
        }
      ]
    },
