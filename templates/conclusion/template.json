          "label": "Subtitle",
          "maxLength": 60
        },
        {
          "name": "title",
          "type": "text",
          "label": "Title",
          "required": true,
          "maxLength": 46
        },
        {
          "name": "body",
          "type": "richtext",
          "label": "Text"
        },
        {
          "name": "image",
          "type": "image",
          "label": "Photo (16:9)",
          "required": true
        }
