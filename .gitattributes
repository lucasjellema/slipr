# Normalise all text files to LF in the repository and in the working copy,
# so diffs stay clean across Windows, macOS, Linux and static hosts.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
*.pptx  binary
*.zip   binary
*.slipr binary
