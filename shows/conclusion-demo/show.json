{
  "$schema": "../../shared/schema/show.schema.json",
  "slipr": "0.1",
  "id": "conclusion-demo",
  "meta": {
    "title": "Slipr in Conclusion style",
    "subtitle": "Every layout of the Conclusion template",
    "author": "Lucas Jellema",
    "date": "2026-10-10",
    "language": "en",
    "description": "A tour of the Conclusion (magenta) Slipr template: one slide per layout. The photos are neutral placeholders; real shows use photography from the brand library."
  },
  "template": { "ref": "../../templates/conclusion", "version": "^0.1" },
  "settings": { "aspectRatio": "16:9", "transition": "fade", "slideNumbers": true, "agenda": true },

  "chapters": [
    { "id": "intro", "title": "Introduction" },
    { "id": "text", "title": "Text and quotes" },
    { "id": "sections", "title": "Sections and visuals" },
    { "id": "cards", "title": "Cards" }
  ],

  "slides": [
    {
      "id": "s-title",
      "layout": "title-wave",
      "chapter": "intro",
      "content": { "title": "Slipr in house style", "byline": "Lucas Jellema" },
      "notes": "Opening slide: title-wave layout.",
      "reader": {
        "summary": "The Conclusion PowerPoint template, rebuilt as a Slipr template.",
        "blocks": [
          { "id": "about", "type": "text", "md": "This show demonstrates every layout of the **Conclusion** template for Slipr. It uses the original logo, footer band and wave artwork from the official PowerPoint template, on the same grid." }
        ]
      }
    },
    {
      "id": "s-agenda",
      "layout": "agenda",
      "chapter": "intro",
      "content": {
        "kicker": "Today",
        "title": "Agenda",
        "items": ["Introduction", "Text and quotes", "Sections and visuals", "Cards", "Questions"],
        "intro": "A short tour of the template.",
        "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a brand photo", "fit": "cover" }
      }
    },
    {
      "id": "s-text",
      "layout": "text",
      "chapter": "text",
      "content": {
        "kicker": "Context",
        "title": "Text on white",
        "body": "One clear message per slide, left-aligned.\n\n**Subheading in capitals**\n\n- First-level bullet\n  - Second level\n    - Third level\n- Back to the first level\n\n*A line in Source Serif italic*\n\nA. Letter list\nB. Second item\n\n1. Numbered list\n2. Second item"
      },
      "reader": {
        "blocks": [
          { "id": "styles", "type": "callout", "variant": "info", "title": "Text styles", "md": "The body supports the template's text styles: bullets up to four levels, a **bold line as subheading**, *serif italic*, letter lists and numbered lists." }
        ]
      }
    },
    {
      "id": "s-text-dark",
      "layout": "text-dark",
      "chapter": "text",
      "content": {
        "kicker": "Context",
        "title": "Text on black",
        "body": "The black variant of the standard text slide.\n\n**What it is for**\n\n- Most content slides in the template are dark\n- Magenta bullets, white text\n  - Up to four levels deep"
      }
    },
    {
      "id": "s-text-image",
      "layout": "text-image",
      "chapter": "text",
      "content": {
        "kicker": "Example",
        "title": "Text and image",
        "body": "- A text column on the left\n- The photo fills the slide behind it\n- A dark gradient keeps the text readable",
        "image": { "src": "images/photo-16x9.svg", "alt": "Placeholder for a brand photo", "fit": "cover" }
      }
    },
    {
      "id": "s-text-quote-image",
      "layout": "text-quote-image",
      "chapter": "text",
      "content": {
        "kicker": "Example",
        "title": "Text, quote and image",
        "body": "- Text on the left\n- A quote on the right\n- The wave lines over the photo",
        "quote": "One source, two very different experiences.",
        "image": { "src": "images/photo-16x9.svg", "alt": "Placeholder for a brand photo", "fit": "cover" }
      }
    },
    {
      "id": "s-quote-box",
      "layout": "quote-box",
      "chapter": "text",
      "content": {
        "kicker": "Key message",
        "title": "Quote in a box",
        "quote": "Slides for the room, depth for the reader, and the house style for both.",
        "image": { "src": "images/photo-16x9.svg", "alt": "Placeholder for a brand photo", "fit": "cover" }
      }
    },
    {
      "id": "s-quote-image",
      "layout": "quote-image",
      "chapter": "text",
      "content": {
        "kicker": "Key message",
        "title": "Quote with image",
        "quote": "The template owns the looks; the show owns the content.",
        "image": { "src": "images/photo-16x9.svg", "alt": "Placeholder for a brand photo", "fit": "cover" }
      }
    },
    {
      "id": "s-section-wave",
      "layout": "section-wave",
      "chapter": "sections",
      "content": { "kicker": "Chapter three", "title": "Sections and visuals" }
    },
    {
      "id": "s-title-only",
      "layout": "title-only",
      "chapter": "sections",
      "content": {
        "kicker": "Overview",
        "title": "From PowerPoint to Slipr",
        "image": { "src": "images/diagram.svg", "alt": "Diagram: the converter turns a PowerPoint deck into a Slipr show, which the viewer presents to an audience or a reader", "fit": "contain" }
      }
    },
    {
      "id": "s-section-image",
      "layout": "section-image",
      "chapter": "sections",
      "content": {
        "kicker": "Client case",
        "title": "Section with photo",
        "image": { "src": "images/photo-16x9.svg", "alt": "Placeholder for a brand photo", "fit": "cover" }
      }
    },
    {
      "id": "s-columns",
      "layout": "columns-4",
      "chapter": "cards",
      "audience": { "fragments": true },
      "content": {
        "kicker": "Approach",
        "title": "Four columns",
        "cards": [
          { "title": "Analyse", "text": "Read the PowerPoint template and list its layouts.\n\n- Placeholders\n- Text styles" },
          { "title": "Map", "text": "Give every placeholder a role in a Slipr slot or card." },
          { "title": "Convert", "text": "Run the converter; leftovers go to the reader layer." },
          { "title": "Review", "text": "Compare with the PowerPoint export, slide by slide." }
        ]
      },
      "reader": {
        "blocks": [
          { "id": "cards-format", "type": "callout", "variant": "info", "title": "Cards", "md": "A **cards** slot holds a list of small records with named fields. The layout decides what one card looks like; the show only provides the fields." }
        ]
      }
    },
    {
      "id": "s-boxes",
      "layout": "boxes-9",
      "chapter": "cards",
      "content": {
        "kicker": "Overview",
        "title": "Nine numbered boxes",
        "cards": [
          { "title": "Template", "text": "Theme, layouts and slots." },
          { "title": "Show", "text": "Content as JSON, no styling." },
          { "title": "Audience mode", "text": "A linear slideshow." },
          { "title": "Reader mode", "text": "Depth, search and notes." },
          { "title": "Profiles", "text": "Tailored for each reader." },
          { "title": "Converter", "text": "PowerPoint in, Slipr out." },
          { "title": "Editor", "text": "Edit shows in the browser." },
          { "title": "Offline", "text": "No network calls at all." },
          { "title": "Open format", "text": "A documented JSON schema." }
        ]
      }
    },
    {
      "id": "s-facts",
      "layout": "facts",
      "chapter": "cards",
      "content": {
        "kicker": "In numbers",
        "title": "Facts and figures",
        "cards": [
          { "value": "17", "label": "layouts in this template", "icon": { "src": "images/icon-placeholder.svg", "alt": "Placeholder icon" } },
          { "value": "2", "label": "modes from one show", "icon": { "src": "images/icon-placeholder.svg", "alt": "Placeholder icon" } },
          { "value": "0", "label": "runtime network calls", "icon": { "src": "images/icon-placeholder.svg", "alt": "Placeholder icon" } },
          { "value": "4", "label": "bullet levels", "icon": { "src": "images/icon-placeholder.svg", "alt": "Placeholder icon" } },
          { "value": "9", "label": "slot types", "icon": { "src": "images/icon-placeholder.svg", "alt": "Placeholder icon" } },
          { "value": "1", "label": "renderer for viewer and editor", "icon": { "src": "images/icon-placeholder.svg", "alt": "Placeholder icon" } }
        ],
        "image": { "src": "images/photo-16x9.svg", "alt": "Placeholder for a brand photo" }
      }
    },
    {
      "id": "s-image-cards",
      "layout": "image-cards-8",
      "chapter": "cards",
      "content": {
        "kicker": "Our markets",
        "title": "Eight image cards",
        "cards": [
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a brand photo" }, "title": "Finance" },
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a brand photo" }, "title": "Public sector" },
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a brand photo" }, "title": "Healthcare" },
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a brand photo" }, "title": "Energy" },
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a brand photo" }, "title": "Logistics" },
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a brand photo" }, "title": "Retail" },
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a brand photo" }, "title": "Industry" },
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a brand photo" }, "title": "Education" }
        ]
      }
    },
    {
      "id": "s-people",
      "layout": "people-2",
      "chapter": "cards",
      "content": {
        "kicker": "Introduction",
        "title": "Two people",
        "cards": [
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a portrait" }, "name": "First Speaker", "role": "Principal consultant", "text": "Works on presentation tooling and the house style." },
          { "image": { "src": "images/photo-1x1.svg", "alt": "Placeholder for a portrait" }, "name": "Second Speaker", "role": "Designer", "text": "Looks after the brand library and the templates." }
        ]
      }
    },
    {
      "id": "s-closing",
      "layout": "title-image",
      "chapter": "sections",
      "content": {
        "title": "Thank you",
        "byline": "Questions?",
        "image": { "src": "images/photo-16x9.svg", "alt": "Placeholder for a brand photo", "fit": "cover" }
      }
    }
  ]
}
