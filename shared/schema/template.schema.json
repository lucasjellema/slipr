{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slipr.local/schema/template.schema.json",
  "title": "Slipr template",
  "description": "A Slipr template manifest (template.json), format version 0.3 (0.1 and 0.2 are still valid). Spec: docs/template-format.md",
  "type": "object",
  "required": ["slipr", "id", "name", "version", "theme", "layouts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "slipr": { "enum": ["0.1", "0.2", "0.3"], "description": "Template format version. 0.2 adds placeholder roles to pptxMapping and pptxIgnore; 0.3 adds pictureStyles." },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the template, e.g. 1.0.0."
    },
    "description": { "type": "string" },
    "theme": { "type": "string", "minLength": 1, "description": "Path to theme.css, relative to template.json." },
    "reader": { "type": "string", "description": "Path to reader.css, relative to template.json." },
    "styleguide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": { "type": "object", "additionalProperties": { "type": "string" } },
        "fonts": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layout" }
    },
    "pptxMapping": {
      "type": "object",
      "description": "PowerPoint layout name -> Slipr layout id, or (0.2) an object with placeholder roles. Used by the converter.",
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "$ref": "#/$defs/pptxLayoutMapping" }
        ]
      }
    },
    "pptxIgnore": {
      "type": "array",
      "description": "(0.2) PowerPoint placeholder idx values that are never content in this template (footer, slide number, theme bar, overlays, logo).",
      "items": { "type": "integer", "minimum": 0 }
    },
    "pictureStyles": {
      "type": "array",
      "description": "(0.3) Named picture styles a picture may use (D-014). Each is the CSS class slipr-picture-<id> in theme.css.",
      "items": { "$ref": "#/$defs/pictureStyle" }
    }
  },
  "$defs": {
    "pictureStyle": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "The class slipr-picture-<id> in theme.css." },
        "label": { "type": "string", "minLength": 1, "description": "Shown by the editor." },
        "description": { "type": "string" },
        "pptxEffect": { "enum": ["shadow", "softEdges", "roundedCorners", "border"], "description": "The PowerPoint picture effect this style stands for (converter)." }
      }
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "pptxLayoutMapping": {
      "type": "object",
      "required": ["layout"],
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/id" },
        "placeholders": {
          "type": "object",
          "description": "Placeholder idx (as a string) -> slot name of the Slipr layout ('title'), a card ('cards[2]') or a card field ('cards[2].title'), or null to ignore that placeholder.",
          "propertyNames": { "type": "string", "pattern": "^\\d+$" },
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(\\[\\d+\\](\\.[A-Za-z0-9][A-Za-z0-9_-]*)?)?$" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["id", "name", "file", "slots"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "file": { "type": "string", "minLength": 1, "description": "HTML fragment, relative to template.json." },
        "preview": { "type": "string", "description": "Thumbnail image, relative to template.json." },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" } }
      }
    },
    "slot": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "type": { "enum": ["text", "richtext", "list", "image", "code", "quote", "chart", "diagram", "web", "cards"] },
        "label": { "type": "string", "description": "Field label in the editor." },
        "help": { "type": "string", "description": "Help text in the editor." },
        "required": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1, "description": "Maximum list items, or (cards) maximum number of cards." },
        "fields": {
          "type": "array",
          "description": "(cards slots) the fields of one card, in order.",
          "items": { "$ref": "#/$defs/cardField" }
        }
      }
    },
    "cardField": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "type": { "enum": ["text", "richtext", "list", "image"] },
        "label": { "type": "string" },
        "help": { "type": "string" },
        "required": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
