{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slipr.local/schema/show.schema.json",
  "title": "Slipr show",
  "description": "A Slipr show (show.json), format version 0.2 (0.1 is still valid). Spec: docs/show-format.md",
  "type": "object",
  "required": ["slipr", "id", "meta", "template", "slides"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "Optional pointer to this schema, for editor autocomplete." },
    "slipr": { "enum": ["0.1", "0.2"], "description": "Show format version. 0.2 adds slide overlays (extra images and text elements), graph slots and blocks, picture style / opacity and glossary aliases; a 0.1 show without them is still valid." },
    "id": { "$ref": "#/$defs/kebabId", "description": "Stable show identifier (kebab-case)." },
    "meta": { "$ref": "#/$defs/meta" },
    "template": { "$ref": "#/$defs/templateRef" },
    "settings": { "$ref": "#/$defs/settings" },
    "chapters": {
      "type": "array",
      "description": "Chapters in display order.",
      "items": { "$ref": "#/$defs/chapter" }
    },
    "glossary": {
      "type": "object",
      "description": "Glossary terms by id. Referenced in Markdown as [[id]] or [[id|text]].",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/glossaryTerm" }
    },
    "profiles": {
      "type": "array",
      "description": "Reader profiles that blocks can be targeted at with 'for'.",
      "items": { "$ref": "#/$defs/profile" }
    },
    "paths": {
      "type": "array",
      "description": "Curated routes through the show for reader mode.",
      "items": { "$ref": "#/$defs/path" }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },

  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Identifier: letters, digits, '-' and '_', starting with a letter or digit."
    },
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lower-case kebab-case identifier."
    },
    "markdown": {
      "type": "string",
      "description": "Slipr Markdown subset: **bold**, *italic*, `code`, [link](url), - lists, [[glossary]], ^[popup], [text](#slide-id)."
    },

    "meta": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "ISO date, YYYY-MM-DD." },
        "language": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$", "description": "BCP-47 language tag, e.g. en or nl-NL." },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },

    "templateRef": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1, "description": "Path or URL of the template folder, relative to show.json." },
        "version": { "type": "string", "description": "Semver range the show was made for, e.g. ^1.0." }
      }
    },

    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspectRatio": { "enum": ["16:9", "4:3"] },
        "transition": { "$ref": "#/$defs/transition" },
        "slideNumbers": { "type": "boolean" },
        "agenda": { "type": "boolean", "description": "Audience mode: insert a generated agenda slide before each chapter." }
      }
    },
    "transition": { "enum": ["none", "fade", "slide", "convex", "concave", "zoom"] },

    "chapter": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      }
    },

    "glossaryTerm": {
      "type": "object",
      "required": ["term", "definition"],
      "additionalProperties": false,
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "description": "(0.2) Other names for the term (plurals, abbreviations, synonyms), matched like the term in reader-mode slides (I-086).",
          "items": { "type": "string", "minLength": 1 }
        },
        "definition": { "$ref": "#/$defs/markdown" },
        "link": { "type": "string" }
      }
    },

    "profile": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },

    "path": {
      "type": "object",
      "required": ["id", "label", "slides"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "slides": {
          "description": "Slide ids in order, or \"*\" for all slides.",
          "anyOf": [
            { "const": "*" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
          ]
        }
      }
    },

    "slide": {
      "type": "object",
      "required": ["id", "layout", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "layout": { "$ref": "#/$defs/id", "description": "Layout id from the template." },
        "chapter": { "$ref": "#/$defs/id" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "content": {
          "type": "object",
          "description": "Audience layer: slot name -> slot value. Slot types come from the template layout.",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/slotValue" }
        },
        "overlays": {
          "type": "array",
          "description": "Extra images (D-013) and text elements (D-016) placed freely on the slide, in front of the layout (format 0.2). Later ones are in front.",
          "items": { "$ref": "#/$defs/overlay" }
        },
        "notes": { "$ref": "#/$defs/markdown" },
        "audience": { "$ref": "#/$defs/audience" },
        "reader": { "$ref": "#/$defs/reader" },
        "_orphaned": {
          "type": "object",
          "description": "Editor-internal: slot values kept after a layout switch, restored when switching back."
        }
      }
    },

    "slotValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/code" },
        { "$ref": "#/$defs/quote" },
        { "$ref": "#/$defs/chart" },
        { "$ref": "#/$defs/diagram" },
        { "$ref": "#/$defs/web" },
        { "$ref": "#/$defs/pdf" },
        { "$ref": "#/$defs/graph" },
        { "$ref": "#/$defs/cards" }
      ]
    },
    "cards": {
      "type": "array",
      "description": "Value of a 'cards' slot: one object per card. Field names and types come from the template's slot definition.",
      "items": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/id" },
        "additionalProperties": {
          "anyOf": [
            { "type": "string" },
            { "$ref": "#/$defs/image" }
          ]
        }
      }
    },
    "overlay": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "description": "An extra image (D-013) or a text element (D-016) on a slide: either `image` or `text`. Position and size are fractions of the slide canvas.",
      "anyOf": [
        { "required": ["image"], "properties": { "text": false, "style": false } },
        { "required": ["text"], "properties": { "image": false } }
      ],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "text": { "type": "string", "description": "A text element (I-089): inline Markdown, lines separated by \\n." },
        "style": { "$ref": "#/$defs/textStyle" },
        "x": { "type": "number", "minimum": 0, "maximum": 1, "description": "Left edge, fraction of the canvas width." },
        "y": { "type": "number", "minimum": 0, "maximum": 1, "description": "Top edge, fraction of the canvas height." },
        "w": { "type": "number", "minimum": 0, "maximum": 1, "description": "Width, fraction of the canvas width." },
        "h": { "type": "number", "minimum": 0, "maximum": 1, "description": "Height, fraction of the canvas height." },
        "fragment": {
          "description": "Appear one by one in audience mode; true or a Reveal fragment style.",
          "anyOf": [
            { "type": "boolean" },
            { "enum": ["fade-in", "fade-up", "fade-down", "fade-left", "fade-right", "fade-in-then-semi-out", "semi-fade-out", "grow", "shrink"] }
          ]
        }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "description": "The look of a text element (D-016, I-089). Lengths are percentages of the slide width. Absent = the template's look for slide text.",
      "properties": {
        "font": { "enum": ["heading", "body", "system", "serif", "mono"], "description": "The template's heading / body / code (mono) font, or a platform font." },
        "size": {
          "description": "Font size: a percentage of the slide width, or the template's size for a kind of text.",
          "anyOf": [
            { "type": "number", "minimum": 0.5, "maximum": 20 },
            { "enum": ["small", "body", "subtitle", "title", "hero"] }
          ]
        },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "uppercase": { "type": "boolean" },
        "align": { "enum": ["left", "center", "right"] },
        "valign": { "enum": ["top", "middle", "bottom"] },
        "color": { "$ref": "#/$defs/hexColor" },
        "background": { "$ref": "#/$defs/hexColor" },
        "backgroundOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 5 },
        "borderStyle": { "enum": ["solid", "dashed", "dotted"] },
        "borderColor": { "$ref": "#/$defs/hexColor" },
        "radius": { "type": "number", "minimum": 0, "maximum": 50 },
        "outlineWidth": { "type": "number", "minimum": 0, "maximum": 2 },
        "outlineColor": { "$ref": "#/$defs/hexColor" },
        "padding": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "hexColor": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$", "description": "A color as #rgb or #rrggbb." },
    "image": {
      "type": "object",
      "required": ["src"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string", "minLength": 1, "description": "Relative to show.json, e.g. images/x.png." },
        "alt": { "type": "string" },
        "fit": { "enum": ["contain", "cover"] },
        "focus": { "type": "string", "description": "CSS object-position, e.g. center or 30% 50%." },
        "style": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "(0.2) Id of one of the template's picture styles (D-014)." },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "description": "(0.2) Opacity of the picture, 0-1; absent means 1." },
        "crop": { "$ref": "#/$defs/imageCrop" },
        "morphId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,59}$", "description": "(0.2) Pairs this picture with the picture of the same name on the next or previous auto-animate slide, so it morphs (I-091)." }
      }
    },
    "imageCrop": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "description": "(0.2) The part of the picture that is shown (I-090), as fractions of the picture. Hotspots stay positions on the whole picture.",
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1, "description": "Left edge, fraction of the picture's width." },
        "y": { "type": "number", "minimum": 0, "maximum": 1, "description": "Top edge, fraction of the picture's height." },
        "w": { "type": "number", "minimum": 0, "maximum": 1, "description": "Width, fraction of the picture's width." },
        "h": { "type": "number", "minimum": 0, "maximum": 1, "description": "Height, fraction of the picture's height." }
      }
    },
    "code": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "quote": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "chart": {
      "type": "object",
      "required": ["kind", "data"],
      "description": "(planned) Data-driven chart.",
      "properties": {
        "kind": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    "web": {
      "type": "object",
      "required": ["url", "title"],
      "additionalProperties": false,
      "description": "(0.2) A web page on a slide (slot type 'web', I-071).",
      "properties": {
        "url": { "type": "string", "minLength": 1, "description": "Absolute https URL, or path relative to show.json." },
        "title": { "type": "string", "minLength": 1 },
        "allow": { "$ref": "#/$defs/webAllow" },
        "present": { "enum": ["live", "static"], "description": "Audience mode: \"live\" (default) loads the page on the slide; \"static\" shows the fallback image." },
        "load": { "enum": ["click", "auto"], "description": "Reader mode, a page on another server: \"click\" (default) waits for the reader's consent, \"auto\" loads straight away (D-011)." },
        "fallback": { "$ref": "#/$defs/image", "description": "Screenshot shown for print, thumbnails, offline presenting and instead of the link card." }
      }
    },
    "pdf": {
      "type": "object",
      "required": ["pdf", "title"],
      "additionalProperties": false,
      "description": "(0.2) A PDF document on a slide (slot type 'pdf', I-072).",
      "properties": {
        "pdf": { "type": "string", "minLength": 1, "description": "The PDF: a path relative to show.json, or an https URL (the server must allow CORS)." },
        "title": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1, "description": "Show this one page." },
        "pages": { "$ref": "#/$defs/pdfPages" },
        "load": { "enum": ["click", "auto"], "description": "Reader mode, a PDF on another server: \"click\" (default) waits for the reader's consent, \"auto\" loads straight away (D-011)." },
        "fallback": { "$ref": "#/$defs/image", "description": "Static image shown for print, thumbnails and when the PDF cannot be shown." }
      }
    },
    "pdfPages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 },
      "description": "(0.2) First and last page (inclusive). Audience mode steps through them on clicks; reader mode limits page navigation to them."
    },
    "webAllow": {
      "type": "array",
      "description": "(0.2) Extra sandbox permissions for an embedded page (I-071). same-origin applies to pages on other servers only.",
      "items": { "enum": ["same-origin", "fullscreen", "modals", "downloads", "presentation"] }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "description": "(0.2) A graph of nodes and edges, drawn with Cytoscape.js (I-074). Needs nodes or a data file.",
      "anyOf": [{ "required": ["nodes"] }, { "required": ["data"] }],
      "properties": {
        "nodes": {
          "type": "array",
          "description": "The nodes: id (unique), label, tags (the first picks a template color), md (shown when selected), slide (a link to that slide).",
          "items": { "$ref": "#/$defs/graphNode" }
        },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/graphEdge" } },
        "data": { "type": "string", "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/).+\\.json$", "description": "A JSON file in the show folder with { nodes, edges }; inline entries come after the file's." },
        "layout": { "enum": ["cose", "breadthfirst", "concentric", "circle", "grid"], "description": "Automatic placement; default cose (force-directed)." },
        "steps": {
          "type": "array",
          "description": "Audience mode, slots only: one per click; show more nodes, or focus one with its neighbours.",
          "items": { "$ref": "#/$defs/graphStep" }
        },
        "caption": { "type": "string" },
        "fallback": { "$ref": "#/$defs/image", "description": "Static image shown for print, thumbnails and when rendering fails (I-070)." }
      }
    },
    "graphNode": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "md": { "$ref": "#/$defs/markdown" },
        "slide": { "type": "string", "minLength": 1 }
      }
    },
    "graphEdge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "label": { "type": "string" }
      }
    },
    "graphStep": {
      "description": "Show more nodes, or focus one node (zoom to it and its neighbours).",
      "anyOf": [
        { "type": "object", "required": ["show"], "additionalProperties": false, "properties": { "show": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
        { "type": "object", "required": ["focus"], "additionalProperties": false, "properties": { "focus": { "type": "string", "minLength": 1 } } }
      ]
    },
    "diagram": {
      "type": "object",
      "required": ["mermaid"],
      "additionalProperties": false,
      "description": "Mermaid diagram.",
      "properties": {
        "mermaid": { "type": "string" },
        "caption": { "type": "string" },
        "fallback": { "$ref": "#/$defs/image", "description": "(0.2) Static image shown for print, thumbnails and when rendering fails (I-070)." }
      }
    },

    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hidden": { "type": "boolean", "description": "Backup slide: skipped while presenting, reachable via the overview." },
        "fragments": {
          "description": "Reveal list items one by one; true or a Reveal fragment style.",
          "anyOf": [
            { "type": "boolean" },
            { "enum": ["fade-in", "fade-up", "fade-down", "fade-left", "fade-right", "fade-in-then-semi-out", "semi-fade-out", "grow", "shrink"] }
          ]
        },
        "autoAnimate": { "type": "boolean", "description": "Morph matching elements into the next/previous auto-animate slide." },
        "transition": { "$ref": "#/$defs/transition" },
        "background": { "type": "string", "description": "CSS color or image path (relative to show.json)." }
      }
    },

    "reader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hidden": { "type": "boolean", "description": "Leave this slide out of reader mode." },
        "showSlide": { "type": "boolean", "description": "Show the slide visual above the blocks (default true)." },
        "summary": { "type": "string", "description": "One-line takeaway." },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "related": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },

    "block": {
      "description": "Reader block; the 'type' field selects the block kind.",
      "anyOf": [
        { "$ref": "#/$defs/blockText" },
        { "$ref": "#/$defs/blockDetails" },
        { "$ref": "#/$defs/blockCallout" },
        { "$ref": "#/$defs/blockTabs" },
        { "$ref": "#/$defs/blockImage" },
        { "$ref": "#/$defs/blockEmbed" },
        { "$ref": "#/$defs/blockSlideRef" },
        { "$ref": "#/$defs/blockDiagram" },
        { "$ref": "#/$defs/blockPdf" },
        { "$ref": "#/$defs/blockGraph" }
      ]
    },
    "for": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "description": "Profile ids that see this block; absent = everyone." },
    "depth": { "enum": [1, 2, 3], "description": "1 essential, 2 standard (default), 3 deep dive." },

    "blockText": {
      "type": "object",
      "required": ["id", "type", "md"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "text" },
        "for": { "$ref": "#/$defs/for" }, "depth": { "$ref": "#/$defs/depth" },
        "md": { "$ref": "#/$defs/markdown" }
      }
    },
    "blockDetails": {
      "type": "object",
      "required": ["id", "type", "title", "md"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "details" },
        "for": { "$ref": "#/$defs/for" }, "depth": { "$ref": "#/$defs/depth" },
        "title": { "type": "string", "minLength": 1 },
        "md": { "$ref": "#/$defs/markdown" },
        "open": { "type": "boolean" }
      }
    },
    "blockCallout": {
      "type": "object",
      "required": ["id", "type", "variant", "md"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "callout" },
        "for": { "$ref": "#/$defs/for" }, "depth": { "$ref": "#/$defs/depth" },
        "variant": { "enum": ["info", "tip", "warning", "quote"] },
        "title": { "type": "string" },
        "md": { "$ref": "#/$defs/markdown" }
      }
    },
    "blockTabs": {
      "type": "object",
      "required": ["id", "type", "tabs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "tabs" },
        "for": { "$ref": "#/$defs/for" }, "depth": { "$ref": "#/$defs/depth" },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "md"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "md": { "$ref": "#/$defs/markdown" }
            }
          }
        }
      }
    },
    "blockImage": {
      "type": "object",
      "required": ["id", "type", "image"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "image" },
        "for": { "$ref": "#/$defs/for" }, "depth": { "$ref": "#/$defs/depth" },
        "image": { "$ref": "#/$defs/image" },
        "caption": { "type": "string" },
        "hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "title", "md"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "title": { "type": "string", "minLength": 1 },
              "md": { "$ref": "#/$defs/markdown" }
            }
          }
        }
      }
    },
    "blockEmbed": {
      "type": "object",
      "required": ["id", "type", "url", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "embed" },
        "for": { "$ref": "#/$defs/for" }, "depth": { "$ref": "#/$defs/depth" },
        "url": { "type": "string", "minLength": 1, "description": "Absolute URL, or path relative to show.json." },
        "title": { "type": "string", "minLength": 1 },
        "height": { "type": "integer", "minimum": 100 },
        "aspect": { "type": "string", "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$", "description": "(0.2) Width:height, e.g. 16:9; the frame scales with the column. Wins over height (I-071)." },
        "allow": { "$ref": "#/$defs/webAllow" },
        "load": { "enum": ["click", "auto"], "description": "(0.2) A page on another server: \"click\" (default) waits for the reader's consent, \"auto\" loads straight away (D-011)." },
        "fallback": { "$ref": "#/$defs/image", "description": "(0.2) Static image shown for print, thumbnails and instead of the link card (I-070)." }
      }
    },
    "blockSlideRef": {
      "type": "object",
      "required": ["id", "type", "slide"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "slide-ref" },
        "for": { "$ref": "#/$defs/for" }, "depth": { "$ref": "#/$defs/depth" },
        "slide": { "$ref": "#/$defs/id" },
        "label": { "type": "string" }
      }
    },
    "blockDiagram": {
      "type": "object",
      "required": ["id", "type", "mermaid"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "diagram" },
        "for": { "$ref": "#/$defs/for" }, "depth": { "$ref": "#/$defs/depth" },
        "mermaid": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "fallback": { "$ref": "#/$defs/image", "description": "(0.2) Static image shown for print, thumbnails and when rendering fails (I-070)." }
      }
    },
    "blockGraph": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "description": "(0.2) A graph in the reader layer (I-074): pan, zoom, select a node, filter by tag.",
      "anyOf": [{ "required": ["nodes"] }, { "required": ["data"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "graph" },
        "for": { "$ref": "#/$defs/for" },
        "depth": { "$ref": "#/$defs/depth" },
        "title": { "type": "string" },
        "nodes": {
          "type": "array",
          "description": "The nodes: id (unique), label, tags (the first picks a template color), md (shown when selected), slide (a link to that slide).",
          "items": { "$ref": "#/$defs/graphNode" }
        },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/graphEdge" } },
        "data": { "type": "string", "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/).+\\.json$", "description": "A JSON file in the show folder with { nodes, edges }; inline entries come after the file's." },
        "layout": { "enum": ["cose", "breadthfirst", "concentric", "circle", "grid"], "description": "Automatic placement; default cose (force-directed)." },
        "caption": { "type": "string" },
        "fallback": { "$ref": "#/$defs/image", "description": "Static image shown for print, thumbnails and when rendering fails (I-070)." }
      }
    },
    "blockPdf": {
      "type": "object",
      "required": ["id", "type", "pdf", "title"],
      "additionalProperties": false,
      "description": "(0.2) A PDF document in the reader layer (I-072).",
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "pdf" },
        "for": { "$ref": "#/$defs/for" }, "depth": { "$ref": "#/$defs/depth" },
        "pdf": { "type": "string", "minLength": 1, "description": "A path relative to show.json, or an https URL (the server must allow CORS)." },
        "title": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "pages": { "$ref": "#/$defs/pdfPages" },
        "load": { "enum": ["click", "auto"] },
        "fallback": { "$ref": "#/$defs/image" }
      }
    }
  }
}
